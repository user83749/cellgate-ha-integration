{
  "name": "scrypted-cellgate-intercom",
  "version": "0.2.1",
  "private": true,
  "description": "Standalone CellGate mobile login, SIP call camera, and two-way audio for Scrypted",
  "license": "UNLICENSED",
  "scripts": {
    "build": "python3 tools/build.py",
    "test": "python3 -m pytest tests -q",
    "scrypted-deploy": "scrypted-deploy"
  },
  "scrypted": {
    "name": "CellGate Intercom",
    "type": "DeviceProvider",
    "interfaces": [
      "DeviceProvider",
      "Settings"
    ],
    "pluginDependencies": [
      "@scrypted/webrtc"
    ],
    "runtime": "python",
    "pythonVersion": {
      "default": "3.12"
    }
  },
  "devDependencies": {
    "@scrypted/sdk": "0.5.59"
  },
  "files": [
    "out/plugin.zip",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
