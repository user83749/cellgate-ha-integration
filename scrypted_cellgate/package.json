{
  "name": "scrypted-cellgate-intercom",
  "version": "0.1.0",
  "private": true,
  "description": "CellGate call camera and talk adapter for an existing CellGate Intercom backend",
  "license": "UNLICENSED",
  "scripts": {
    "build": "scrypted-webpack",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "scrypted-deploy": "scrypted-deploy",
    "test:bundle": "node --test tests/bundle.test.cjs"
  },
  "scrypted": {
    "name": "CellGate Intercom",
    "type": "DeviceProvider",
    "interfaces": [
      "DeviceProvider",
      "Settings"
    ],
    "pluginDependencies": [
      "@scrypted/webrtc"
    ],
    "rollup": true
  },
  "dependencies": {
    "@scrypted/sdk": "0.5.59",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "terser-webpack-plugin": "5.6.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "out/plugin.zip",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
